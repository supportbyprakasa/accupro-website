node_modules/
.DS_Store
shots/

# dist/ is generated by build.mjs — CI rebuilds it on every deploy, into three
# parallel language trees (id at the root, en/ and ch/ mirroring it). But
# dist/assets/ is NOT generated: the stylesheet, main.js and the logo are
# hand-maintained source files that happen to live there, shared by all three
# languages. Ignore everything generated, keep the assets. (See README §4.)
dist/*
!dist/assets/
