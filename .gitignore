node_modules/
.DS_Store
shots/

# dist/ is generated by build.mjs — CI rebuilds it on every deploy, into a
# tree of per-language, per-page directories (dist/en/services/..., etc).
# But dist/assets/ is NOT generated: the stylesheet, main.js and the logo are
# hand-maintained source files that happen to live there, shared by all
# three language trees. Ignore everything generated, keep the assets.
# (See README §4.)
dist/*
!dist/assets/
